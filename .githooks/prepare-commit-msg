#!/usr/bin/env bash
# Strip Co-authored-by: Cursor trailers injected by Cursor IDE agent commits.
# Installed via: git config core.hooksPath .githooks

COMMIT_MSG_FILE="$1"
[[ -f "$COMMIT_MSG_FILE" ]] || exit 0

if sed --version 2>/dev/null | grep -q GNU; then
  sed -i '/^Co-authored-by: Cursor/d' "$COMMIT_MSG_FILE"
else
  sed -i '' '/^Co-authored-by: Cursor/d' "$COMMIT_MSG_FILE"
fi

exit 0
